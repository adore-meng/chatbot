# Company SSO: browser redirect when `company_auth_token` cookie is missing (`middleware.ts`).
# Example: https://sso.mycompany.com/login — we append ?redirect_uri=<origin>/api/auth/callback
COMPANY_SSO_LOGIN_URL=https://sso.mycompany.com/login

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/redis
REDIS_URL=****
